# Avisos push (PWA). Generar claves: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@su-dominio.org
# Secreto del cron que dispara el envío (.github/workflows/push-cron.yml lo manda como Bearer)
CRON_SECRET=
# Base de datos de suscripciones (Supabase). Sin ellas solo funciona en memoria, en desarrollo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fuentes existentes
FIRMS_MAP_KEY=
